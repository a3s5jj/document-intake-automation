        }
      },
      "id": "b2fab2c4-ec4d-41e8-a30b-77262ad09258",
      "name": "Extract Receipt with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        3120,
        832
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_GEMINI_CREDENTIAL_ID",
